# Rates on request — see lib/rates/token.ts.
# Two different random strings, 32 characters or more each:
#   openssl rand -base64 48
RATES_ACCESS_SECRET=
RATES_ADMIN_SECRET=

# Optional — the revoke-all switch. Every token signed before this moment is
# void: open accesses end, pending requests and unanswered approvals lapse.
# RATES_MIN_IAT=2026-10-11T00:00:00Z

# The request form — see lib/rates/mail.ts and lib/rates/actions.ts.
# Where a request is sent (Aly's own inbox):
RATES_NOTIFY_TO=
# A sender on a domain verified with Resend, e.g. "Aly Sanoo <rates@alysanoo.com>":
RATES_MAIL_FROM=
RESEND_API_KEY=
# The public address of the site, no trailing slash. Every link in an email is
# built from it — never from the request.
SITE_URL=https://alysanoo.com
